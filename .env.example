# Supabase (https://supabase.com/dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI (https://platform.openai.com/api-keys) - powers the AI trading coach
OPENAI_API_KEY=

# Polygon.io (https://polygon.io/dashboard/api-keys) - powers quotes, options chains, and charts
# A free-tier key works but returns delayed data; a paid Options plan is needed for live/real-time quotes.
POLYGON_API_KEY=

# Base URL of this app, used for building absolute links (e.g. in emails)
APP_BASE_URL=http://localhost:3000
