# Copy to .env.local and fill in. Do NOT commit real secrets.

# --- OpenAI ---
OPENAI_API_KEY=

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- App ---
APP_BASE_URL=http://localhost:3000

# --- LinkedIn API connection ---
# Create an app at https://www.linkedin.com/developers/apps
# Request the "Sign In with LinkedIn using OpenID Connect" and
# "Share on LinkedIn" products to enable the scopes used here.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Must exactly match an authorized redirect URL configured on the LinkedIn app:
LINKEDIN_REDIRECT_URI=http://localhost:3000/api/linkedin/callback
