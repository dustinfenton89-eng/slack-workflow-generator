# Supabase project settings (required)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Password for the /admin dashboard (required to use /admin)
ADMIN_PASSWORD=

# Shippo API key (optional). When set, sellers get a real, free prepaid USPS
# shipping label instead of a demo placeholder PDF.
SHIPPO_API_KEY=

# Where sellers ship their calculator to. Required if SHIPPO_API_KEY is set
# (real labels need a real destination); a placeholder is used in demo mode.
WAREHOUSE_NAME=
WAREHOUSE_ADDRESS1=
WAREHOUSE_ADDRESS2=
WAREHOUSE_CITY=
WAREHOUSE_STATE=
WAREHOUSE_ZIP=

# PayPal REST app credentials (required to send automated PayPal payouts).
# Create an app at https://developer.paypal.com/dashboard/applications and
# make sure Payouts is enabled on the underlying PayPal business account.
# Defaults to the sandbox API — set PAYPAL_API_BASE to
# https://api-m.paypal.com to send real, live payouts.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
